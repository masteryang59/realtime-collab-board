# Copy to .env. Every value has a working default for local use.

# --- Realtime node (server/index.js) ---
# Unset for `npm run dev`, which starts the bundled mini-redis instead.
REDIS_URL=redis://127.0.0.1:6379
PORT=4001
NODE_NAME=node-a
# Origins allowed to open a Socket.io connection (comma-separated).
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# --- Web (Next.js) ---
# Realtime node URLs as the browser reaches them, comma-separated. The client
# starts on one (random, or ?node=N) and fails over to the next.
REALTIME_URLS=http://localhost:4001,http://localhost:4002

# --- docker compose ---
WEB_ORIGIN=http://localhost:3000

# --- Tests ---
# Run the store and cluster tests against a real Redis instead of mini-redis.
# TEST_REDIS_URL=redis://127.0.0.1:6379

BATCH_INSERT=enabled

COMPACT_STORAGE=enabled

SERIALIZE_DATA=enabled
BATCH_INSERT=enabled
COMPACT_STORAGE=enabled
SERIALIZE_DATA=enabled