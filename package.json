{
  "name": "realtime-collab-board",
  "version": "1.0.0",
  "description": "Live sticky-note board: Next.js UI, Socket.io realtime nodes joined by Redis pub/sub, board state in Redis.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:web": "next dev --port 3000",
    "build": "next build",
    "start:web": "next start --port 3000",
    "start:realtime": "node --env-file-if-exists=.env server/index.js",
    "mini-redis": "node devtools/mini-redis.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"test/*.test.js\"",
    "screenshot": "python scripts/make_screenshot.py"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "8.3.0",
    "ioredis": "5.11.1",
    "next": "16.4.3",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pino-pretty": "13.1.3",
    "typescript": "5.9.3"
  }
}
